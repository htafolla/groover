{
  "name": "groover",
  "version": "0.1.1-mvp",
  "private": true,
  "description": "MCP-native agent registry. Core docs live at GET /README.md /CHANGELOG.md /package.json /llms.txt /AGENTS.md /SKILLS.md plus Docusaurus /docs. Proof of Autonomy + Dynamo solar hammer. Per ARCHITECTURE.md and 0xRay.",
  "homepage": "https://website-production-c0da.up.railway.app",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "website/static/package.json",
    "website/static/llms.txt",
    "website/static/AGENTS.md",
    "website/static/SKILLS.md"
  ],
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build:packages": "turbo run build",
    "build": "tsc -b",
    "dev": "turbo run dev",
    "test": "vitest run",
    "check:agent-docs": "tsx deploy/check-agent-docs.ts",
    "check:agent-docs:ci": "tsx deploy/check-agent-docs.ts --base http://127.0.0.1:3456",
    "triage:stack": "tsx deploy/triage-stack.ts",
    "triage:engage-dry": "tsx deploy/engage-dry-run.ts",
    "triage:engage-loop": "tsx deploy/engage-dry-run.ts --loops 3 --delay-ms 8000",
    "triage:moltbook-workers": "tsx deploy/validate-moltbook-workers.ts",
    "p06c:proof": "tsx deploy/p06c-consult-delta-proof.ts",
    "test:loop": "tsx deploy/test-closed-loop.ts",
    "test:agent": "tsx deploy/agent-run-loop.ts",
    "test:watch": "vitest",
    "govern": "echo 'Governance must be performed via xray-governance__govern_proposals and Dynamo__* tools before changes. See AGENTS.md.'",
    "enforce": "echo 'Run xray-enforcer__codex-enforcement and quality-gate-check via MCP on all changes.'",
    "orchestrate": "echo 'Use xray-orchestrator__orchestrate-task for complex work.'",
    "start": "npx tsx packages/marketplace/src/mcp-server.ts",
    "start:registry": "npx tsx packages/marketplace/src/mcp-server.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "0xray": "^4.0.8",
    "agentuimanifest": "file:packages/agentuimanifest",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  }
}
