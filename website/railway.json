{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "npx docusaurus serve --port $PORT --host 0.0.0.0",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
